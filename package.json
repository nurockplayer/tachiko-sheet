{
  "name": "tachiko-sheet-acceptance-seed",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/harness.test.mjs",
    "fixture": "node scripts/materialize-fixture.mjs",
    "acceptance:web": "node tests/browser.mjs",
    "acceptance:agent": "node tests/agent.mjs",
    "serve:canary": "node scripts/serve-canary.mjs",
    "acceptance:kit": "node tests/kit.mjs",
    "acceptance:storage": "node tests/storage.mjs",
    "acceptance:agent-ui": "node tests/browser.mjs --agent",
    "qualification:real-kit-notes": "node tests/qualification/real-kit-notes.mjs",
    "qualification:real-kit-explain-field": "node tests/qualification/real-kit-explain-field.mjs",
    "qualification:j3-public-composition": "node tests/qualification/j3-public-composition.mjs",
    "qualification:j4-public-composition": "node tests/qualification/j4-public-composition.mjs",
    "qualification:visual-foundation-fixture": "node scripts/visual-foundation-generate-fixture.mjs",
    "qualification:visual-foundation-fixture:static": "node scripts/visual-foundation-qualify-fixture.mjs",
    "evidence:visual-foundation-populated": "node scripts/visual-foundation-capture-populated.mjs",
    "evidence:visual-foundation-final": "node scripts/visual-foundation-capture-final.mjs",
    "evidence:visual-foundation-recovery": "node scripts/visual-foundation-capture-recovery.mjs",
    "dev": "node scripts/copy-example-fixture.mjs && vite",
    "build": "node scripts/copy-example-fixture.mjs && vite build && node scripts/check-dist.mjs dist",
    "build:acceptance": "node scripts/copy-example-fixture.mjs && vite build --mode acceptance",
    "preview:acceptance": "vite preview --mode acceptance",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run src/runtime src/ui src/application src/host/appearance-preference.test.ts src/host/interface-profile-files.test.ts src/App.test.ts tests/product tests/desktop/native-channel.test.ts && node --test src/host/local-copies.test.mjs tests/product/example-copy.node.mjs tests/verify-core-kit-provenance.test.mjs tests/dev-core-kit.test.mjs",
    "test:runner-lifecycle": "node --test tests/runner-process-lifecycle.test.mjs",
    "verify:core-kit": "node scripts/verify-core-kit.mjs",
    "qualification:core-kit": "node scripts/qualify-core-kit.mjs",
    "acceptance:product": "node scripts/run-product-acceptance.mjs",
    "acceptance:save-closure": "node scripts/run-save-closure-acceptance.mjs",
    "acceptance:production-lifecycle": "node scripts/run-production-lifecycle.mjs",
    "acceptance:product:local": "WORK_DIST=dist-acceptance node tests/product/m1-local.mjs",
    "test:visual-foundation": "node tests/product/visual-foundation-regression.mjs",
    "dev:desktop": "node scripts/copy-example-fixture.mjs && vite --mode desktop",
    "build:desktop": "node scripts/copy-example-fixture.mjs && vite build --mode desktop && node scripts/finish-desktop-dist.mjs dist-desktop && node scripts/check-dist.mjs dist-desktop",
    "desktop:build": "CI=true tauri build --target aarch64-apple-darwin",
    "desktop:dev": "tauri dev",
    "test:desktop-evidence": "node --test tests/desktop/desktop-evidence.test.mjs",
    "test:desktop-host": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "desktop:build:e2e": "tauri build --target aarch64-apple-darwin --bundles app --features e2e --config src-tauri/tauri.e2e.conf.json",
    "acceptance:desktop": "node tests/desktop/packaged-lifecycle.mjs",
    "test:desktop-parity": "cargo build --locked --release --example frame_harness --manifest-path src-tauri/Cargo.toml && vitest run tests/desktop/native-parity.test.ts",
    "acceptance:display-names": "node tests/product/display-names-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
