{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tachiko Sheet",
  "version": "0.1.0",
  "identifier": "dev.tachiko.sheet",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev:desktop",
    "beforeBuildCommand": "pnpm build:desktop"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "public.app-category.productivity",
    "shortDescription": "Tachiko Sheet",
    "longDescription": "Tachiko Sheet: a spreadsheet backed by the native Tachiko Work runtime.",
    "copyright": "Tachiko",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "fileAssociations": [
      { "ext": ["ro"], "name": "Tachiko Work File", "description": "Tachiko work file", "role": "Editor", "rank": "Owner", "mimeType": "application/x-tachiko-work" },
      { "ext": ["xlsx"], "name": "Excel Workbook", "description": "Excel workbook", "role": "Viewer", "rank": "Alternate", "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" },
      { "ext": ["csv"], "name": "CSV File", "description": "Comma-separated values", "role": "Viewer", "rank": "Alternate", "mimeType": "text/csv" }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
