{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The Sheet window may reach only the private native runtime channel, the close check and export saving.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-runtime-attach",
    "allow-runtime-dispatch",
    "allow-window-close-check",
    "allow-save-attach",
    "allow-save-export"
  ]
}
